# Diretorio de inicializacao local do Terraform
.terraform/

# Ficheiros de estado do Terraform (contêm dados sensiveis e IPs)
*.tfstate
*.tfstate.backup

# Ficheiros de variaveis e credenciais/chaves privadas
*.tfvars
*.pem
*.key

# Ficheiros executaveis binarios (ex: instaladores baixados)
*.exe

# Logs e ficheiros temporarios do sistema operativo
*.log
.DS_Store
Thumbs.db