            "dashboard_arn": "arn:aws:cloudwatch::415840117777:dashboard/TCC-Netryon-AWS-VPN",
            "dashboard_body": "{\"widgets\":[{\"height\":6,\"properties\":{\"metrics\":[[\"AWS/EC2\",\"NetworkIn\",\"InstanceId\",\"i-026001b4519f4bc92\",{\"label\":\"Tráfego Recebido (VPN/IoT)\"}],[\".\",\"NetworkOut\",\".\",\".\",{\"label\":\"Tráfego Enviado (Resposta AWS)\"}]],\"period\":60,\"region\":\"us-east-1\",\"stacked\":false,\"stat\":\"Sum\",\"title\":\"Tráfego de Rede VPN IPsec (Bytes)\",\"view\":\"timeSeries\"},\"type\":\"metric\",\"width\":12,\"x\":0,\"y\":0},{\"height\":6,\"properties\":{\"metrics\":[[\"AWS/EC2\",\"CPUUtilization\",\"InstanceId\",\"i-026001b4519f4bc92\",{\"label\":\"Uso de CPU (%)\"}]],\"period\":60,\"region\":\"us-east-1\",\"stat\":\"Average\",\"title\":\"CPU - Gateway VPN\",\"view\":\"singleValue\"},\"type\":\"metric\",\"width\":6,\"x\":12,\"y\":0},{\"height\":6,\"properties\":{\"metrics\":[[\"AWS/EC2\",\"StatusCheckFailed\",\"InstanceId\",\"i-026001b4519f4bc92\",{\"label\":\"Falhas de Saúde (0 = OK)\"}]],\"period\":60,\"region\":\"us-east-1\",\"stat\":\"Maximum\",\"title\":\"Saúde da Instância EC2\",\"view\":\"singleValue\"},\"type\":\"metric\",\"width\":6,\"x\":18,\"y\":0},{\"height\":6,\"properties\":{\"metrics\":[[\"AWS/EC2\",\"NetworkPacketsIn\",\"InstanceId\",\"i-026001b4519f4bc92\",{\"label\":\"Pacotes Recebidos (Pkts)\"}],[\".\",\"NetworkPacketsOut\",\".\",\".\",{\"label\":\"Pacotes Enviados (Pkts)\"}]],\"period\":60,\"region\":\"us-east-1\",\"stacked\":false,\"stat\":\"Sum\",\"title\":\"Volume de Pacotes - Túnel IPsec \u0026 Telemetria\",\"view\":\"timeSeries\"},\"type\":\"metric\",\"width\":12,\"x\":0,\"y\":6},{\"height\":6,\"properties\":{\"alarms\":[\"arn:aws:cloudwatch:us-east-1:415840117777:alarm:Saude-Gateway-VPN-AWS\"],\"title\":\"Status do Alarme (EC2 Health)\"},\"type\":\"alarm\",\"width\":6,\"x\":12,\"y\":6},{\"height\":6,\"properties\":{\"markdown\":\"## Arquitetura AWS TCC\\n- **VPC:** `10.0.1.0/24` (`us-east-1`)\\n- **Gateway EC2:** `10.0.1.10` (`t3.micro`)\\n- **VPN:** StrongSwan IKEv2 (AES-256 / SHA-256)\\n- **Failover:** `right=%any` + DPD (FortiGate HA)\\n- **Zero Trust:** SSH (VLAN 10) | IoT Web (VLAN 40)\"},\"type\":\"text\",\"width\":6,\"x\":18,\"y\":6},{\"height\":6,\"properties\":{\"metrics\":[[\"TCC/VPN\",\"TunnelStatus\",\"InstanceId\",\"i-026001b4519f4bc92\",{\"label\":\"Túnel IPsec (1 = UP | 0 = DOWN)\"}]],\"period\":60,\"region\":\"us-east-1\",\"stacked\":false,\"stat\":\"Minimum\",\"title\":\"Disponibilidade do Túnel VPN IPsec (Histórico)\",\"view\":\"timeSeries\",\"yAxis\":{\"left\":{\"max\":1,\"min\":0}}},\"type\":\"metric\",\"width\":12,\"x\":0,\"y\":12},{\"height\":6,\"properties\":{\"metrics\":[[\"TCC/VPN\",\"TunnelStatus\",\"InstanceId\",\"i-026001b4519f4bc92\",{\"label\":\"1 = UP (Ativo) | 0 = DOWN\"}]],\"period\":60,\"region\":\"us-east-1\",\"stat\":\"Minimum\",\"title\":\"Estado Túnel IPsec\",\"view\":\"singleValue\"},\"type\":\"metric\",\"width\":6,\"x\":12,\"y\":12},{\"height\":6,\"properties\":{\"alarms\":[\"arn:aws:cloudwatch:us-east-1:415840117777:alarm:Status-Tunel-IPsec-AWS\"],\"title\":\"Status do Alarme (Túnel VPN)\"},\"type\":\"alarm\",\"width\":6,\"x\":18,\"y\":12}]}",
